# OSINT Time Machine - Variáveis de Ambiente

# Porta do servidor (default: 5000)
# PORT=5000

# Redis para cache (opcional)
# REDIS_URL=redis://localhost:6379/0

# GitHub API token para coleta (opcional - aumenta limite de requests)
# GITHUB_TOKEN=ghp_xxxx

# Rate limit - requisições por minuto por IP
# RATE_LIMIT=10
